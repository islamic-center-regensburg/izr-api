    "Operation class (CRUD + pagination pattern)": {
        "prefix": "opclass",
        "description": "Creates an Operation class using DatabaseRepositoryProvider + Filter + PaginationBuilder (list/get/create/update).",
        "body": [
            "from src.core.db.pagination import PaginationBuilder",
            "from src.core.db.filters import Filter, Operator",
            "from src.core.db.database_repository_provider import DatabaseRepositoryProvider",
            "",
            "from src.features.${1:feature}.schemas import ${2:Entity}Filter, ${2:Entity}In, ${2:Entity}Table, ${2:Entity}Update",
            "",
            "",
            "class ${2:Entity}Operation:",
            "    def __init__(self, db_repository_provider: DatabaseRepositoryProvider):",
            "        self.__db_repository_provider = db_repository_provider",
            "",
            "    def get_all_${3:entities}(self, filter: ${2:Entity}Filter):",
            "        filters = [",
            "            # Filter(attribute=\"${4:field}\", value=filter.${4:field}, operator=Operator.EQ),",
            "        ]",
            "        with self.__db_repository_provider.get_database_repository() as db:",
            "            data = db.get_all(",
            "                ${2:Entity}Table,",
            "                filters=filters,",
            "                limit=filter.limit,",
            "                offset=filter.offset,",
            "            )",
            "            total = db.count(${2:Entity}Table, filters=filters)",
            "            return PaginationBuilder.build(",
            "                items=data,",
            "                total=total,",
            "                page=filter.page,",
            "                size=filter.size,",
            "            )",
            "",
            "    def get_${5:entity}_by_id(self, ${5:entity}_id: int):",
            "        with self.__db_repository_provider.get_database_repository() as db:",
            "            return db.get_by_id(${2:Entity}Table, ${5:entity}_id)",
            "",
            "    def create(self, ${5:entity}_in: ${2:Entity}In):",
            "        with self.__db_repository_provider.get_database_repository() as db:",
            "            record = ${2:Entity}Table(**${5:entity}_in.model_dump())",
            "            return db.create(record)",
            "",
            "    def update(self, ${5:entity}_id: int, ${5:entity}_update: ${2:Entity}Update):",
            "        with self.__db_repository_provider.get_database_repository() as db:",
            "            entity = db.get_by_id(${2:Entity}Table, ${5:entity}_id)",
            "            if entity is None:",
            "                return None",
            "",
            "            for key, value in ${5:entity}_update.model_dump(exclude_unset=True).items():",
            "                setattr(entity, key, value)",
            "",
            "            return db.update(entity)"
        ]
    },
