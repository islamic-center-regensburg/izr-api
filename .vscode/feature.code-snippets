    "Controller class (RouterBuilder + guard + Depends for filters)": {
        "prefix": "ctrlclass",
        "description": "Creates a Controller class using RouterBuilder with LIST/GET/CREATE/UPDATE endpoints. Uses Depends() for filter models and @guard for exception handling.",
        "body": [
            "from fastapi import APIRouter, Depends",
            "",
            "from src.core.db.pagination import PaginatedList",
            "from src.core.exceptions import guard",
            "from src.core.router.router_builder import EndpointType, RouterBuilder",
            "from src.features.${1:feature}.component import ${2:Entity}Component",
            "from src.features.${1:feature}.schemas import ${2:Entity}In, ${2:Entity}Filter, ${2:Entity}Out, ${2:Entity}Update",
            "",
            "",
            "class ${2:Entity}Controller:",
            "    def __init__(self, ${3:entity_component}: ${2:Entity}Component):",
            "        self.__${3:entity_component} = ${3:entity_component}",
            "",
            "    def get_router(self) -> APIRouter:",
            "        router_builder = RouterBuilder(\"/${4:path}\", [\"${5:Tag}\"])",
            "",
            "        router_builder.add_method(",
            "            \"\",",
            "            endpoint_type=EndpointType.LIST,",
            "            endpoint=self.__list,",
            "            response_model=PaginatedList[${2:Entity}Out],",
            "            summary=\"List ${6:entities}\",",
            "        )",
            "",
            "        router_builder.add_method(",
            "            \"/{${7:entity}_id}\",",
            "            endpoint_type=EndpointType.GET,",
            "            endpoint=self.__get_by_id,",
            "            response_model=${2:Entity}Out,",
            "            summary=\"Get ${8:entity} by ID\",",
            "        )",
            "",
            "        router_builder.add_method(",
            "            \"\",",
            "            endpoint_type=EndpointType.CREATE,",
            "            endpoint=self.__create,",
            "            response_model=${2:Entity}Out,",
            "            summary=\"Create ${8:entity}\",",
            "        )",
            "",
            "        router_builder.add_method(",
            "            \"/{${7:entity}_id}\",",
            "            endpoint_type=EndpointType.UPDATE,",
            "            endpoint=self.__update,",
            "            response_model=${2:Entity}Out,",
            "            summary=\"Update ${8:entity}\",",
            "        )",
            "",
            "        return router_builder.get_router()",
            "",
            "    @guard",
            "    def __list(self, filter: ${2:Entity}Filter = Depends()) -> PaginatedList[${2:Entity}Out]:",
            "        return self.__${3:entity_component}.get_all_${6:entities}(filter)",
            "",
            "    @guard",
            "    def __get_by_id(self, ${7:entity}_id: int) -> ${2:Entity}Out:",
            "        return self.__${3:entity_component}.get_${8:entity}_by_id(${7:entity}_id)",
            "",
            "    @guard",
            "    def __create(self, data: ${2:Entity}In) -> ${2:Entity}Out:",
            "        return self.__${3:entity_component}.create_${8:entity}(data)",
            "",
            "    @guard",
            "    def __update(self, ${7:entity}_id: int, data: ${2:Entity}Update) -> ${2:Entity}Out:",
            "        return self.__${3:entity_component}.update_${8:entity}(${7:entity}_id, data)"
        ]
    },
    "SQLModel schema pattern (base -> in -> out -> table -> update -> filter)": {
        "prefix": "schema",
        "description": "Creates SQLModel schemas following base -> in -> out -> table -> update -> filter. Filter extends PageParams.",
        "body": [
            "from __future__ import annotations",
            "",
            "from typing import Optional",
            "",
            "from sqlmodel import SQLModel, Field",
            "",
            "from src.core.db.pagination import PageParams",
            "",
            "",
            "class ${1:Entity}Base(SQLModel):",
            "    ${2:field}: ${3:type} = Field(${4:...})",
            "",
            "",
            "class ${1:Entity}In(${1:Entity}Base):",
            "    pass",
            "",
            "",
            "class ${1:Entity}Out(${1:Entity}Base):",
            "    id: int",
            "",
            "",
            "class ${1:Entity}Table(${1:Entity}Base, table=True):",
            "    __tablename__ = \"${5:table_name}\"",
            "    id: int | None = Field(default=None, primary_key=True, index=True)",
            "",
            "",
            "class ${1:Entity}Update(SQLModel):",
            "    ${2:field}: Optional[${3:type}] = None",
            "",
            "",
            "class ${1:Entity}Filter(PageParams):",
            "    ${2:field}: Optional[${3:type}] = None"
        ]
    }
