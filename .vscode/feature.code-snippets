            "from src.features.${1:feature}.operation import ${2:Entity}Operation",
            "${3:from src.features.other_feature.operation import OtherOperation}",
            "",
            "",
            "class ${2:Entity}Component:",
            "    def __init__(",
            "        self,",
            "        ${4:entity_operation}: ${2:Entity}Operation,",
            "        ${5:other_operation}: ${6:OtherOperation},",
            "    ):",
            "        self.__${4:entity_operation} = ${4:entity_operation}",
            "        self.__${5:other_operation} = ${5:other_operation}",
            "",
            "    def get_all_${7:entities}(self, filter: ${2:Entity}Filter):",
